# Database Configuration (Replace with your local credentials)
DATABASE_URL=postgresql+asyncpg://qbox_app:password@localhost:5432/qbox_db
DATABASE_SYNC_URL=postgresql+psycopg2://qbox_app:password@localhost:5432/qbox_db

# Security & Tokens
SECRET_KEY=change_me_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# QR Token Encryption & Registration URLs
QR_ENCRYPTION_KEY=change_me_to_base64_32_bytes_key_in_production

# Centralized Development Environment Configuration
# Set DEV_TARGET to 'emulator' for Android Emulator (10.0.2.2:8000)
# or 'physical' for physical Android phone testing (uses DEV_HOST_IP:DEV_PORT)
DEV_TARGET=emulator
DEV_HOST_IP=192.168.1.5
DEV_PORT=8000

# Optional explicit base URL override (uncomment to override automatic resolution)
# REGISTRATION_BASE_URL=http://10.0.2.2:8000/join

# Environment
ENVIRONMENT=development
DEBUG=True

